programa {
  funcao inicio() {
    
   inteiro n1, n2

   

   escreva ("Digite um numero: ")
   leia (n1)
   escreva ("Digite um numero: ")
   leia(n2)
   

   escreva ("Soma: ", n1+n2 ) escreva ("   Dividido: ",n1/n2 )
   escreva ("\n", "Multiplicação: ", n1*n2) escreva ("  Subtração: ", n1-n2 )



  }
}
