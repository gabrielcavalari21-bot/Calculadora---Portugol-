programa {
  funcao inicio() {
    


    cadeia apresenta
    inteiro num1
    inteiro num2
   
    
    

    escreva ("Escreva um numero por vez para saber o resultado do calculo! ")
    leia(apresenta)
    limpa ()
    escreva ("Escreva aqui um numero de 1 a 10: ")
    leia (num1 )
    limpa ()
    escreva ("Escreva aqui outro numero de 1 a 10: ")
    leia (num2)

    limpa ()


   escreva ("resultado: ", num1+num2)
    




  }
}
